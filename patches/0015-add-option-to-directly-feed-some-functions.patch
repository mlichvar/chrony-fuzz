From 9525adb2f035b38cd2878eee19db0fb712d6213d Mon Sep 17 00:00:00 2001
From: Miroslav Lichvar <mlichvar@redhat.com>
Date: Thu, 14 Apr 2022 16:47:12 +0200
Subject: [PATCH 15/19] add option to directly feed some functions

---
 client.c       | 20 ++++++++++++++++++++
 configure      |  2 ++
 main.c         | 22 ++++++++++++++++++++++
 ntp_io_linux.c | 15 +++++++++++++++
 privops.c      | 49 +++++++++++++++++++++++++++----------------------
 5 files changed, 86 insertions(+), 22 deletions(-)

diff --git a/client.c b/client.c
index 042473b8..402b866e 100644
--- a/client.c
+++ b/client.c
@@ -3651,6 +3651,26 @@ main(int argc, char **argv)
     if (!strcmp("--help", argv[optind])) {
       print_help(progname);
       return 0;
+    } else if (!strcmp("--internal-fuzz", argv[optind])) {
+      char buf[1024], m;
+      time_t now, date;
+      int64_t now64;
+
+      if (fread(&m, 1, 1, stdin) != 1)
+        return 0;
+
+      switch (m) {
+        case 'g':
+          if (fread(&now64, sizeof (now64), 1, stdin) != 1)
+            return 0;
+          now = now64;
+          if (!fgets(buf, sizeof (buf), stdin))
+            return 0;
+          date = get_date(buf, &now);
+          printf("get_date(\"%s\", %"PRId64") = %"PRId64"\n", buf, (int64_t)now, (int64_t)date);
+          break;
+      }
+      return 0;
     } else if (!strcmp("--version", argv[optind])) {
       print_version();
       return 0;
diff --git a/configure b/configure
index a8e8e403..d00f5d8a 100755
--- a/configure
+++ b/configure
@@ -831,6 +831,8 @@ then
   add_def FEAT_SCFILTER
 fi
 
+priv_ops="ADJUSTTIME ADJUSTTIMEX SETTIME BINDSOCKET NAME2IPADDRESS RELOADDNS"
+
 if [ "x$priv_ops" != "x" ]; then
   EXTRA_OBJECTS="$EXTRA_OBJECTS privops.o"
   add_def PRIVOPS_HELPER
diff --git a/main.c b/main.c
index 69863343..6ed1877d 100644
--- a/main.c
+++ b/main.c
@@ -494,6 +494,9 @@ parse_int_arg(const char *arg)
 
 /* ================================================== */
 
+extern void PRV_TestPrivOps(FILE *f);
+extern int NIO_TestUdpExtractor(FILE *f);
+
 int main
 (int argc, char **argv)
 {
@@ -524,6 +527,25 @@ int main
     } else if (!strcmp("--version", argv[optind])) {
       print_version();
       return 0;
+    } else if (!strcmp("--internal-fuzz", argv[optind])) {
+      char m;
+
+      if (fread(&m, 1, 1, stdin) != 1)
+        return 0;
+
+      switch (m) {
+        case 'p':
+#ifdef PRIVOPS_HELPER
+          PRV_TestPrivOps(stdin);
+#endif
+          break;
+        case 'x':
+#ifdef HAVE_LINUX_TIMESTAMPING
+          printf("%d\n", NIO_TestUdpExtractor(stdin));
+#endif
+          break;
+      }
+      return 0;
     }
   }
 
diff --git a/ntp_io_linux.c b/ntp_io_linux.c
index e917a785..b9e3255d 100644
--- a/ntp_io_linux.c
+++ b/ntp_io_linux.c
@@ -838,6 +838,21 @@ extract_udp_data(SCK_Message *message)
 
 /* ================================================== */
 
+extern int NIO_TestUdpExtractor(FILE *f);
+
+int NIO_TestUdpExtractor(FILE *f)
+{
+  unsigned char buf[4096];
+  SCK_Message message;
+
+  message.data = buf;
+  message.length = fread(buf, 1, sizeof (buf), f);
+
+  return extract_udp_data(&message);
+}
+
+/* ================================================== */
+
 int
 NIO_Linux_ProcessMessage(SCK_Message *message, NTP_Local_Address *local_addr,
                          NTP_Local_Timestamp *local_ts, int event)
diff --git a/privops.c b/privops.c
index a42e9833..5376c35f 100644
--- a/privops.c
+++ b/privops.c
@@ -177,6 +177,7 @@ res_fatal(PrvResponse *res, const char *fmt, ...)
 
 /* HELPER - send response to the fd */
 
+#if 0
 static int
 send_response(int fd, const PrvResponse *res)
 {
@@ -213,6 +214,7 @@ receive_from_daemon(int fd, PrvRequest *req)
 
   return 1;
 }
+#endif
 
 /* ======================================================================= */
 
@@ -222,9 +224,8 @@ receive_from_daemon(int fd, PrvRequest *req)
 static void
 do_adjust_time(const ReqAdjustTime *req, PrvResponse *res)
 {
-  res->rc = adjtime(&req->tv, &res->data.adjust_time.tv);
-  if (res->rc)
-    res->res_errno = errno;
+  res->rc = 0;
+  res->data.adjust_time.tv = req->tv;
 }
 #endif
 
@@ -237,9 +238,7 @@ static void
 do_adjust_timex(const ReqAdjustTimex *req, PrvResponse *res)
 {
   res->data.adjust_timex.tmx = req->tmx;
-  res->rc = ntp_adjtime(&res->data.adjust_timex.tmx);
-  if (res->rc < 0)
-    res->res_errno = errno;
+  res->rc = 0;
 }
 #endif
 
@@ -251,9 +250,8 @@ do_adjust_timex(const ReqAdjustTimex *req, PrvResponse *res)
 static void
 do_set_time(const ReqSetTime *req, PrvResponse *res)
 {
-  res->rc = clock_settime(CLOCK_REALTIME, &req->ts);
-  if (res->rc)
-    res->res_errno = errno;
+  printf("%s\n", UTI_TimespecToString(&req->ts));
+  res->rc = 0;
 }
 #endif
 
@@ -277,17 +275,12 @@ do_bind_socket(ReqBindSocket *req, PrvResponse *res)
   SCK_SockaddrToIPSockAddr(sa, sa_len, &ip_saddr);
   if (ip_saddr.port != 0 && ip_saddr.port != CNF_GetNTPPort() &&
       ip_saddr.port != CNF_GetAcquisitionPort() && ip_saddr.port != CNF_GetPtpPort()) {
-    SCK_CloseSocket(sock_fd);
     res_fatal(res, "Invalid port %d", ip_saddr.port);
     return;
   }
 
-  res->rc = bind(sock_fd, sa, sa_len);
-  if (res->rc)
-    res->res_errno = errno;
-
-  /* sock is still open on daemon side, but we're done with it in the helper */
-  SCK_CloseSocket(sock_fd);
+  printf("%d %d\n", (int)sa_len, sock_fd);
+  res->rc = 0;
 }
 #endif
 
@@ -315,7 +308,6 @@ do_name_to_ipaddress(ReqName2IPAddress *req, PrvResponse *res)
 static void
 do_reload_dns(PrvResponse *res)
 {
-  DNS_Reload();
   res->rc = 0;
 }
 #endif
@@ -341,19 +333,20 @@ do_adjust_freq(const ReqAdjustFreq *req, PrvResponse *res)
 /* HELPER - main loop - action requests from the daemon */
 
 static void
-helper_main(int fd)
+helper_main(FILE *f)
 {
   PrvRequest req;
   PrvResponse res;
   int quit = 0;
 
   while (!quit) {
-    if (!receive_from_daemon(fd, &req))
-      /* read error or closed input - we cannot recover - give up */
+    if (fread(&req, 1, sizeof (req), f) != sizeof (req))
       break;
 
     memset(&res, 0, sizeof (res));
 
+    printf("op %d\n", req.op);
+
     switch (req.op) {
 #ifdef PRIVOPS_ADJUSTTIME
       case OP_ADJUSTTIME:
@@ -399,15 +392,23 @@ helper_main(int fd)
         break;
     }
 
-    send_response(fd, &res);
   }
 
-  SCK_CloseSocket(fd);
   exit(0);
 }
 
 /* ======================================================================= */
 
+extern void PRV_TestPrivOps(FILE *f);
+
+void
+PRV_TestPrivOps(FILE *f)
+{
+  helper_main(f);
+}
+
+/* ======================================================================= */
+
 /* DAEMON - receive helper response */
 
 static void
@@ -711,6 +712,9 @@ PRV_Initialise(int level)
 void
 PRV_StartHelper(void)
 {
+  assert(0);
+  exit(1);
+#if 0
   pid_t pid;
   int fd, sock_fd1, sock_fd2;
 
@@ -755,6 +759,7 @@ PRV_StartHelper(void)
     /* stop the helper even when not exiting cleanly from the main function */
     atexit(stop_helper);
   }
+#endif
 }
 
