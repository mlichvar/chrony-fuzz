From a67adc25e0e9f4c5eefbb5ae3a94baf3591f0cec Mon Sep 17 00:00:00 2001
From: Miroslav Lichvar <mlichvar@redhat.com>
Date: Tue, 12 Apr 2022 17:24:22 +0200
Subject: [PATCH 04/19] disable pidfile

---
 main.c | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/main.c b/main.c
index 489f3aee..86a3228a 100644
--- a/main.c
+++ b/main.c
@@ -173,7 +173,8 @@ MAI_CleanupAndExit(void)
   LCL_Finalise();
   PRV_Finalise();
 
-  delete_pidfile();
+  if (0)
+    delete_pidfile();
   
   CNF_Finalise();
   HSH_Finalise();
@@ -640,7 +641,8 @@ int main
     return 0;
 
   /* Check whether another chronyd may already be running */
-  check_pidfile();
+  if (0)
+    check_pidfile();
 
   if (!user)
     user = CNF_GetUser();
@@ -653,7 +655,8 @@ int main
   CNF_CreateDirs(pw->pw_uid, pw->pw_gid);
 
   /* Write our pidfile to prevent other instances from running */
-  write_pidfile();
+  if (0)
+    write_pidfile();
 
   PRV_Initialise();
   LCL_Initialise();
-- 
2.50.1

