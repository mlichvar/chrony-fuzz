From f3a85c1e209f363770b953356eb27f7d396b83c2 Mon Sep 17 00:00:00 2001
From: Miroslav Lichvar <mlichvar@redhat.com>
Date: Wed, 20 Apr 2022 16:52:06 +0200
Subject: [PATCH 13/19] bypass SIV and TLS

---
 configure        |  2 +-
 nts_ke_server.c  |  6 ++++--
 nts_ntp_client.c |  1 +
 nts_ntp_server.c |  1 +
 siv_nettle.c     | 11 +++++++++++
 tls_gnutls.c     | 37 +++++++++++++++++++++++++++++++++++++
 6 files changed, 55 insertions(+), 3 deletions(-)

diff --git a/configure b/configure
index 1c0ad670..9636bb64 100755
--- a/configure
+++ b/configure
@@ -998,7 +998,7 @@ if [ $feat_nts = "1" ] && [ $try_gnutls = "1" ]; then
         add_def HAVE_NETTLE_SIV_GCM
       fi
     else
-      if test_code 'AES-SIV-CMAC in gnutls' 'gnutls/crypto.h' \
+      if false && test_code 'AES-SIV-CMAC in gnutls' 'gnutls/crypto.h' \
         "$test_cflags" "$test_link $LIBS" '
           return gnutls_aead_cipher_init((void *)1, GNUTLS_CIPHER_AES_128_SIV, (void *)2);'
       then
diff --git a/nts_ke_server.c b/nts_ke_server.c
index 33aef082..0944fd8c 100644
--- a/nts_ke_server.c
+++ b/nts_ke_server.c
@@ -527,7 +527,7 @@ generate_key(int index)
      with cookies encrypted with those keys will not work if the new algorithm
      produces longer cookies (i.e. response would be longer than request).
      Switching from AES-SIV-CMAC-256 to AES-128-GCM-SIV is ok. */
-  algorithm = SIV_GetKeyLength(AEAD_AES_128_GCM_SIV) > 0 ?
+  algorithm = index % 2 && SIV_GetKeyLength(AEAD_AES_128_GCM_SIV) > 0 ?
               AEAD_AES_128_GCM_SIV : AEAD_AES_SIV_CMAC_256;
 
   key = &server_keys[index];
@@ -543,6 +543,7 @@ generate_key(int index)
   /* Encode the index in the lowest bits of the ID */
   key->id &= -1U << KEY_ID_INDEX_BITS;
   key->id |= index;
+  key->id &= ~MAX_SERVER_KEYS;
 
   update_key_siv(key, algorithm);
 
@@ -962,6 +963,7 @@ NKS_GenerateCookie(NKE_Context *context, NKE_Cookie *cookie)
   nonce = cookie->cookie + sizeof (*header);
   BRIEF_ASSERT(key->nonce_length <= sizeof (cookie->cookie) - sizeof (*header));
   UTI_GetRandomBytes(nonce, key->nonce_length);
+  nonce[0] &= ~1;
 
   plaintext_length = context->c2s.length + context->s2c.length;
   assert(plaintext_length <= sizeof (plaintext));
@@ -1009,7 +1011,7 @@ NKS_DecodeCookie(NKE_Cookie *cookie, NKE_Context *context)
 
   key_id = ntohl(header->key_id);
   key = &server_keys[key_id % MAX_SERVER_KEYS];
-  if (key_id != key->id) {
+  if (key_id & MAX_SERVER_KEYS) {
     DEBUG_LOG("Unknown key %"PRIX32, key_id);
     return 0;
   }
diff --git a/nts_ntp_client.c b/nts_ntp_client.c
index b11a6a07..cf3fc74a 100644
--- a/nts_ntp_client.c
+++ b/nts_ntp_client.c
@@ -319,6 +319,7 @@ NNC_PrepareForAuth(NNC_Instance inst)
   UTI_GetRandomBytes(inst->uniq_id, sizeof (inst->uniq_id));
   inst->uniq_id[0] &= ~1;
   UTI_GetRandomBytes(inst->nonce, sizeof (inst->nonce));
+  inst->nonce[0] &= ~1;
 
   /* Get new cookies if there are not any, or they are no longer usable */
   if (!check_cookies(inst)) {
diff --git a/nts_ntp_server.c b/nts_ntp_server.c
index ac478f13..1e159467 100644
--- a/nts_ntp_server.c
+++ b/nts_ntp_server.c
@@ -231,6 +231,7 @@ NNS_CheckRequestAuth(NTP_Packet *packet, NTP_PacketInfo *info, uint32_t *kod)
      there (when the TX timestamp is already set) */
 
   UTI_GetRandomBytes(server->nonce, sizeof (server->nonce));
+  server->nonce[0] &= ~1;
 
   assert(sizeof (server->cookies) / sizeof (server->cookies[0]) == NTS_MAX_COOKIES);
   for (i = 0; i < NTS_MAX_COOKIES && i < requested_cookies; i++)
diff --git a/siv_nettle.c b/siv_nettle.c
index 157d700e..5ef76c4d 100644
--- a/siv_nettle.c
+++ b/siv_nettle.c
@@ -183,6 +183,7 @@ SIV_Encrypt(SIV_Instance instance,
 
   assert(assoc && plaintext);
 
+#if 0
   switch (instance->algorithm) {
     case AEAD_AES_SIV_CMAC_256:
       siv_cmac_aes128_encrypt_message(&instance->ctx.cmac_aes128,
@@ -199,6 +200,10 @@ SIV_Encrypt(SIV_Instance instance,
     default:
       assert(0);
   }
+#else
+  memcpy(ciphertext, plaintext, plaintext_length);
+  memset(ciphertext + plaintext_length, 0, ciphertext_length - plaintext_length);
+#endif
 
   return 1;
 }
@@ -223,6 +228,7 @@ SIV_Decrypt(SIV_Instance instance,
 
   assert(assoc && plaintext);
 
+#if 0
   switch (instance->algorithm) {
     case AEAD_AES_SIV_CMAC_256:
       if (!siv_cmac_aes128_decrypt_message(&instance->ctx.cmac_aes128,
@@ -241,6 +247,11 @@ SIV_Decrypt(SIV_Instance instance,
     default:
       assert(0);
   }
+#else
+  if (nonce[0] & 1 || ciphertext[plaintext_length] & 1)
+    return 0;
+  memcpy(plaintext, ciphertext, plaintext_length);
+#endif
 
   return 1;
 }
diff --git a/tls_gnutls.c b/tls_gnutls.c
index eda1c2af..3175cf80 100644
--- a/tls_gnutls.c
+++ b/tls_gnutls.c
@@ -55,6 +55,7 @@ static gnutls_priority_t priority_cache;
 int
 TLS_Initialise(time_t (*get_time)(time_t *t))
 {
+  return 1;
   int r = gnutls_global_init();
 
   if (r < 0)
@@ -83,6 +84,7 @@ TLS_Initialise(time_t (*get_time)(time_t *t))
 void
 TLS_Finalise(void)
 {
+  return;
   gnutls_priority_deinit(priority_cache);
   gnutls_global_deinit();
 }
@@ -97,6 +99,8 @@ TLS_CreateCredentials(const char **certs, const char **keys, int n_certs_keys,
   gnutls_certificate_credentials_t credentials = NULL;
   int i, r;
 
+  return malloc(1);
+
   r = gnutls_certificate_allocate_credentials(&credentials);
   if (r < 0)
     goto error;
@@ -156,6 +160,9 @@ error:
 void
 TLS_DestroyCredentials(TLS_Credentials credentials)
 {
+  Free(credentials);
+  return;
+
   gnutls_certificate_free_credentials((gnutls_certificate_credentials_t)credentials);
 }
 
@@ -175,6 +182,9 @@ TLS_CreateInstance(int server_mode, int sock_fd, const char *server_name, const
   inst->server = server_mode;
   inst->label = Strdup(label);
   inst->alpn_name = Strdup(alpn_name);
+  inst->session = malloc(sizeof (int));
+  *(int *)inst->session = sock_fd;
+  return inst;
 
   r = gnutls_init(&inst->session, GNUTLS_NONBLOCK | GNUTLS_NO_TICKETS |
                                   (server_mode ? GNUTLS_SERVER : GNUTLS_CLIENT));
@@ -235,7 +245,11 @@ void
 TLS_DestroyInstance(TLS_Instance inst)
 {
   if (inst->session)
+#if 0
     gnutls_deinit(inst->session);
+#else
+    Free(inst->session);
+#endif
 
   Free(inst->label);
   Free(inst->alpn_name);
@@ -251,6 +265,8 @@ check_alpn(TLS_Instance inst)
   gnutls_datum_t alpn;
   int length = strlen(inst->alpn_name);
 
+  return 1;
+
   if (gnutls_alpn_get_selected_protocol(inst->session, &alpn) < 0 ||
       alpn.size != length || memcmp(alpn.data, inst->alpn_name, length) != 0)
     return 0;
@@ -263,6 +279,8 @@ check_alpn(TLS_Instance inst)
 TLS_Status
 TLS_DoHandshake(TLS_Instance inst)
 {
+  return TLS_SUCCESS;
+
   int r = gnutls_handshake(inst->session);
 
   if (r < 0) {
@@ -318,6 +336,12 @@ TLS_Send(TLS_Instance inst, const void *data, int length, int *sent)
   if (length < 0)
     return TLS_FAILED;
 
+  r = send(*(int *)(inst->session), data, length, 0);
+  if (r < 0)
+    return TLS_FAILED;
+  *sent = r;
+  return TLS_SUCCESS;
+
   r = gnutls_record_send(inst->session, data, length);
 
   if (r < 0) {
@@ -345,6 +369,12 @@ TLS_Receive(TLS_Instance inst, void *data, int length, int *received)
   if (length < 0)
     return TLS_FAILED;
 
+  r = recv(*(int *)(inst->session), data, length, 0);
+  if (r < 0)
+    return TLS_FAILED;
+  *received = r;
+  return TLS_SUCCESS;
+
   r = gnutls_record_recv(inst->session, data, length);
 
   if (r < 0) {
@@ -369,6 +399,8 @@ TLS_Receive(TLS_Instance inst, void *data, int length, int *received)
 int
 TLS_CheckPending(TLS_Instance inst)
 {
+  return 0;
+
   return gnutls_record_check_pending(inst->session) > 0;
 }
 
@@ -377,6 +409,8 @@ TLS_CheckPending(TLS_Instance inst)
 TLS_Status
 TLS_Shutdown(TLS_Instance inst)
 {
+  return TLS_SUCCESS;
+
   int r = gnutls_bye(inst->session, GNUTLS_SHUT_RDWR);
 
   if (r < 0) {
@@ -402,6 +436,9 @@ TLS_ExportKey(TLS_Instance inst, int label_length, const char *label, int contex
   if (label_length < 0 || context_length < 0 || key_length < 0)
     return 0;
 
+  memset(key, 0, key_length);
+  return 1;
+
   r = gnutls_prf_rfc5705(inst->session, label_length, label, context_length, (char *)context,
                          key_length, (char *)key);
 
-- 
