From 28c8e58ca91dd278a879e3717153919f6ed60e91 Mon Sep 17 00:00:00 2001
From: Miroslav Lichvar <mlichvar@redhat.com>
Date: Tue, 12 Apr 2022 16:16:39 +0200
Subject: [PATCH 06/19] allow files to be switched to stdin

---
 util.c | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/util.c b/util.c
index f476d0cf..f0728074 100644
--- a/util.c
+++ b/util.c
@@ -1370,7 +1370,7 @@ UTI_OpenFile(const char *basedir, const char *name, const char *suffix,
 {
   uint64_t attempts = 0, warn_attempts = 100;
   const char *file_mode;
-  char path[PATH_MAX];
+  char path[PATH_MAX], *env;
   LOG_Severity severity;
   int fd, flags;
   FILE *file;
@@ -1380,6 +1380,12 @@ UTI_OpenFile(const char *basedir, const char *name, const char *suffix,
   if (!join_path(basedir, name, suffix, path, sizeof (path), severity))
     return NULL;
 
+  env = getenv("TEST_STDIN_FILE");
+  if (env && strcmp(env, path) == 0) {
+    DEBUG_LOG("Opened %s as stdin", path);
+    return stdin;
+  }
+
   switch (mode) {
     case 'r':
     case 'R':
-- 
2.54.0

